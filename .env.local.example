# Local-only development example.
# Copy this file to .env.local and fill values locally. Never commit real secrets.
# SQLite is local-only. Staging/live use distinct Neon PostgreSQL secrets.
VSN_DB_TARGET=local-sqlite
# Relative to prisma/local/schema.prisma; creates prisma/local/dev.db.
DATABASE_URL=file:./dev.db
SHOPIFY_API_KEY=local-development-app-client-id
SHOPIFY_API_SECRET=local-development-app-client-secret
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_products,write_metaobject_definitions,write_metaobjects,write_products,read_orders
