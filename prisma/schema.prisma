generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Bounded, shop-isolated import ledger. No tokens or customer/order data.
model MetafieldJob {
  id          String   @id
  shop        String
  status      String   @default("preview")
  inputHash   String
  rowsJson    String
  resultsJson String   @default("[]")
  cursor      Int      @default(0)
  revision    Int      @default(0)
  lockToken   String?
  lockUntil   DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop, createdAt])
  @@index([expiresAt])
}
