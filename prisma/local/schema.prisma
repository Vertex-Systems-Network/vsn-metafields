// Local development only. Keep Session fields in sync with ../schema.prisma.
generator client {
  provider   = "prisma-client-js"
  output     = "../generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Bounded, shop-isolated import ledger. No tokens or customer/order data.
model MetafieldJob {
  id          String   @id
  shop        String
  status      String   @default("preview")
  inputHash   String
  rowsJson    String
  resultsJson String   @default("[]")
  cursor      Int      @default(0)
  revision    Int      @default(0)
  lockToken   String?
  lockUntil   DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop, createdAt])
  @@index([expiresAt])
}

model PrivacyRequest {
  id            String    @id
  shop          String
  customerId    String?
  customerEmail String?
  customerPhone String?
  ordersJson    String    @default("[]")
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([shop, createdAt])
  @@index([status, completedAt])
}
