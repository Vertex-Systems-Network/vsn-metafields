{%- liquid
  assign product_owner = block.settings.source_product | default: product
  assign collection_owner = block.settings.source_collection | default: collection
  assign source = block.settings.source
  assign owner = nil
  assign track_variant = false
  if request.page_type == 'product' and product_owner.id == product.id
    assign track_variant = true
  endif
  if source == 'auto'
    case request.page_type
      when 'product'
        assign owner = product_owner
      when 'collection'
        assign owner = collection_owner
      when 'article'
        assign owner = article
      when 'blog'
        assign owner = blog
      when 'page'
        assign owner = page
      else
        assign owner = shop
    endcase
  else
    case source
      when 'product'
        assign owner = product_owner
      when 'variant'
        assign owner = product_owner.selected_or_first_available_variant
      when 'collection'
        assign owner = collection_owner
      when 'shop'
        assign owner = shop
      when 'article'
        assign owner = article
      when 'blog'
        assign owner = blog
      when 'page'
        assign owner = page
    endcase
  endif
-%}
{%- assign field = owner.metafields[block.settings.namespace][block.settings.field_key] -%}
{%- capture value_output -%}{%- render 'vsn-field-value', field: field, settings: block.settings -%}{%- endcapture -%}
{%- if value_output != blank or block.settings.fallback != blank or request.design_mode or source == 'variant' -%}
<div id="vsn-{{ block.id }}" class="vsn-metafield-block vsn-metafield-block--{{ block.settings.layout }} vsn-visibility--{{ block.settings.visibility }}" data-vsn-block data-vsn-track="{{ track_variant }}" data-vsn-source="{{ source }}" data-vsn-section="{{ section.id }}" data-vsn-product="{{ product_owner.id }}" data-vsn-variant="{{ product_owner.selected_or_first_available_variant.id }}" style="{% render 'vsn-block-style', settings: block.settings %}" {{ block.shopify_attributes }} {% if value_output == blank and block.settings.fallback == blank and request.design_mode == false %}hidden{% endif %}>
  {%- if block.settings.show_label and block.settings.label != blank -%}<span class="vsn-metafield-block__label">{{ block.settings.label | escape }}</span>{%- endif -%}
  <div class="vsn-metafield-block__value">
  {%- if value_output != blank -%}{{ value_output }}
  {%- elsif block.settings.fallback != blank -%}{{ block.settings.fallback | escape }}
  {%- elsif request.design_mode -%}Choose a public metafield namespace/key for this resource. Missing or unsupported values are hidden on the storefront.
  {%- endif -%}</div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Single field",
  "target": "section",
  "stylesheet": "vsn-metafields.css",
  "javascript": "vsn-metafields.js",
  "settings": [
