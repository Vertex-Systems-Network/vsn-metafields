      "options": [
        {
          "value": "auto",
          "label": "Current page"
        },
        {
          "value": "product",
          "label": "Product"
        },
        {
          "value": "variant",
          "label": "Selected product variant"
        },
        {
          "value": "collection",
          "label": "Collection"
        },
        {
          "value": "shop",
          "label": "Shop"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "article",
          "label": "Article"
        },
        {
          "value": "blog",
          "label": "Blog"
        }
      ],
      "default": "auto"
    },
    {
      "type": "product",
      "id": "source_product",
      "label": "Product override"
    },
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Collection override"
    },
    {
      "type": "text",
      "id": "namespace",
      "label": "Default namespace",
      "default": "vsn_metafields"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "field_key",
      "label": "Metafield key"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Details"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
