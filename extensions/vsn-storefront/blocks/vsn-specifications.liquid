{%- liquid
  assign product_owner = block.settings.source_product | default: product
  assign collection_owner = block.settings.source_collection | default: collection
  assign source = block.settings.source
  assign owner = nil
  assign track_variant = false
  if request.page_type == 'product' and product_owner.id == product.id
    assign track_variant = true
  endif
  if source == 'auto'
    case request.page_type
      when 'product'
        assign owner = product_owner
      when 'collection'
        assign owner = collection_owner
      when 'article'
        assign owner = article
      when 'blog'
        assign owner = blog
      when 'page'
        assign owner = page
      else
        assign owner = shop
    endcase
  else
    case source
      when 'product'
        assign owner = product_owner
      when 'variant'
        assign owner = product_owner.selected_or_first_available_variant
      when 'collection'
        assign owner = collection_owner
      when 'shop'
        assign owner = shop
      when 'article'
        assign owner = article
      when 'blog'
        assign owner = blog
      when 'page'
        assign owner = page
    endcase
  endif
-%}
{%- capture rows -%}
{%- for index in (1..5) -%}
  {%- liquid
    assign key_setting = 'key_' | append: index
    assign label_setting = 'label_' | append: index
    assign field_identity = block.settings[key_setting] | split: '.'
    assign field_namespace = block.settings.namespace
    assign field_key = field_identity | first
    if field_identity.size > 1
      assign field_namespace = field_identity | first
      assign field_key = field_identity | last
    endif
    assign field = owner.metafields[field_namespace][field_key]
  -%}
  {%- capture value_output -%}{%- render 'vsn-field-value', field: field, settings: block.settings -%}{%- endcapture -%}
  {%- if field_key != blank -%}
    {%- if value_output != blank or block.settings.hide_empty == false -%}
      <div class="vsn-metafield-block__row"><dt>{{ block.settings[label_setting] | default: field_key | escape }}</dt><dd>{% if value_output != blank %}{{ value_output }}{% else %}{{ block.settings.empty_text | default: '—' | escape }}{% endif %}</dd></div>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- if rows != blank or block.settings.fallback != blank or request.design_mode or source == 'variant' -%}
<div id="vsn-{{ block.id }}" class="vsn-metafield-block vsn-metafield-block--{{ block.settings.layout }} vsn-visibility--{{ block.settings.visibility }}" data-vsn-block data-vsn-track="{{ track_variant }}" data-vsn-source="{{ source }}" data-vsn-section="{{ section.id }}" data-vsn-product="{{ product_owner.id }}" data-vsn-variant="{{ product_owner.selected_or_first_available_variant.id }}" style="{% render 'vsn-block-style', settings: block.settings %}" {{ block.shopify_attributes }} data-vsn-columns="{{ block.settings.columns }}" {% if rows == blank and block.settings.fallback == blank and request.design_mode == false %}hidden{% endif %}>
  {% if block.settings.heading != blank %}<h2 class="vsn-metafield-block__label">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if rows != blank %}<dl class="vsn-metafield-block__rows vsn-metafield-block__value">{{ rows }}</dl>
  {% elsif block.settings.fallback != blank %}{{ block.settings.fallback | escape }}
  {% elsif request.design_mode %}Add field keys in display order; use namespace.key to mix namespaces. Empty or private fields are hidden.{% endif %}
</div>
{%- endif -%}
