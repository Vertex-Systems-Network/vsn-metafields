{%- liquid
  assign owner = product
  if request.page_type == 'collection'
    assign owner = collection
  endif
-%}
{%- capture rows -%}
  {%- for index in (1..5) -%}
    {%- assign key_setting = 'key_' | append: index -%}
    {%- assign label_setting = 'label_' | append: index -%}
    {%- assign field_key = block.settings[key_setting] -%}
    {%- if owner != blank and block.settings.namespace != blank and field_key != blank -%}
      {%- assign field = owner.metafields[block.settings.namespace][field_key] -%}
      {%- assign supported = false -%}
      {%- if field != blank -%}
        {%- case field.type -%}
          {%- when 'boolean', 'date', 'url', 'single_line_text_field', 'multi_line_text_field', 'number_integer' -%}
            {%- assign supported = true -%}
        {%- endcase -%}
      {%- endif -%}
      {%- assign has_value = false -%}
      {%- if supported and field.value != blank -%}
        {%- assign has_value = true -%}
      {%- elsif supported and field.type == 'boolean' and field.value == false -%}
        {%- assign has_value = true -%}
      {%- endif -%}
      {%- if has_value -%}
        <div class="vsn-metafield-block__row">
          <dt>{{ block.settings[label_setting] | default: field_key | escape }}</dt>
          <dd>{%- render 'vsn-field-value', field: field, true_text: block.settings.true_text, false_text: block.settings.false_text, link_text: field.value -%}</dd>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if rows != blank or request.design_mode -%}
  <div class="vsn-metafield-block vsn-metafield-block--{{ block.settings.layout }}" style="--vsn-width: {{ block.settings.width }}px; --vsn-padding: {{ block.settings.padding }}px; --vsn-radius: {{ block.settings.radius }}px; --vsn-gap: {{ block.settings.gap }}px; --vsn-size: {{ block.settings.font_size }}px; --vsn-align: {{ block.settings.alignment }}; --vsn-background: {{ block.settings.background }}; --vsn-color: {{ block.settings.text_color }}; --vsn-border: {{ block.settings.border_color }};" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="vsn-metafield-block__label">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if rows != blank -%}
      <dl class="vsn-metafield-block__rows vsn-metafield-block__value">{{ rows }}</dl>
    {%- elsif request.design_mode -%}
      Configure field keys with values for this product or collection.
    {%- endif -%}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "VSN specifications",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product",
      "collection"
    ]
  },
  "stylesheet": "vsn-metafields.css",
  "settings": [
    {
      "type": "text",
      "id": "namespace",
      "label": "Namespace",
      "default": "vsn_metafields"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specifications"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "rows",
          "label": "Rows"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ],
      "default": "rows"
    },
    {
      "type": "text",
      "id": "key_1",
      "label": "Field 1 key"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Field 1 label"
    },
    {
      "type": "text",
      "id": "key_2",
      "label": "Field 2 key"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Field 2 label"
    },
    {
      "type": "text",
      "id": "key_3",
      "label": "Field 3 key"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Field 3 label"
    },
    {
      "type": "text",
      "id": "key_4",
      "label": "Field 4 key"
    },
    {
      "type": "text",
      "id": "label_4",
      "label": "Field 4 label"
    },
    {
      "type": "text",
      "id": "key_5",
      "label": "Field 5 key"
    },
    {
      "type": "text",
      "id": "label_5",
      "label": "Field 5 label"
    },
    {
      "type": "text",
      "id": "true_text",
      "label": "True label",
      "default": "Yes"
    },
    {
      "type": "text",
      "id": "false_text",
      "label": "False label",
      "default": "No"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Row gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "width",
      "label": "Maximum width",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#dddddd"
    }
  ]
}
{% endschema %}
