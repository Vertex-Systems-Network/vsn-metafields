{
  "name": "vsn-metafields",
  "private": true,
  "scripts": {
    "build": "prisma generate && react-router build",
    "dev": "npx --yes shopify@4.8.2 app dev --config local",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "railway-build": "prisma generate && prisma migrate deploy && react-router build",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:contracts": "node --test tests/app-contracts.test.mjs",
    "dev:local": "npm run dev",
    "check:release": "npm run lint && npm run typecheck && npm run test:contracts && npm run build"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-router/dev": "^7.18.4",
    "@react-router/fs-routes": "^7.18.4",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.13",
    "@shopify/shopify-app-react-router": "^3.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "prisma": "6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4",
    "@prisma/adapter-pg": "6.19.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/polaris-types": "1.1.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "@types/pg": "8.23.1"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "deepmerge-ts": "^8.0.2",
    "lodash": "4.18.1"
  },
  "author": "AbdulHanan"
}
